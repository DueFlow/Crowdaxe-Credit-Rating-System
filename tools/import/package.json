    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crowdaxe/db": "workspace:*",
    "@crowdaxe/engine": "workspace:*",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "vitest": "~3.2.4"
  }
}
