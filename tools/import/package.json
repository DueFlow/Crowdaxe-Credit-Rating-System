{
  "name": "@crowdaxe/import",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Imports Crowdaxe_CRS.xlsm into the CRS database, with a dry run and a reconciliation report",
  "bin": {
    "crs-import": "src/cli.ts"
  },
  "scripts": {
    "import": "tsx src/cli.ts",
