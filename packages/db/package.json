{
  "name": "@crowdaxe/db",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Crowdaxe CRS database: Prisma schema, migrations, data access, workbook loader and seed",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@crowdaxe/engine": "workspace:*",
    "@prisma/client": "6.19.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "vitest": "~3.2.4"
  }
}
