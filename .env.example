# Crowdaxe CRS environment variables. Copy to .env (never commit .env).

# --- Database -------------------------------------------------------------------------------------
# Local development (docker compose up db):
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crs_dev
#   DIRECT_URL=postgresql://postgres:postgres@localhost:5432/crs_dev
# Supabase: the app uses the pooled connection (port 6543, PgBouncer) as the least-privilege crs_app role;
# migrations use the direct connection (port 5432) as the owner. See ops/sql/README.md.
DATABASE_URL=postgresql://crs_app.PROJECT_REF:PASSWORD@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# --- Tests (integration tests create and drop their own databases on this server) -----------------
TEST_DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
# Optional: path to the workbook, for the importer's workbook tests (the file is not in the repository)
CRS_WORKBOOK=
